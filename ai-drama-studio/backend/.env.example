# AI API Keys（至少配置一个）
ANTHROPIC_API_KEY=sk-ant-xxxxx
GOOGLE_API_KEY=AIzaxxxxx

# AI 后端选择：claude | gemini
AI_MODEL=claude

# Claude 模型
CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini 模型
GEMINI_MODEL=gemini-2.0-flash

# PySceneDetect 参数
SCENE_THRESHOLD=27.0
MIN_SCENE_LEN=15

# 存储目录
UPLOAD_DIR=./uploads
FRAME_DIR=./frames
STANDARDIZED_DIR=./standardized
