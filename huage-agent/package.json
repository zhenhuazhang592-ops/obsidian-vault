{
  "name": "huage-agent",
  "version": "0.1.0",
  "description": "华哥创作智能体 — 专注文章创作的 Writing Workflow Engine",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "huage-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:stages": "vitest run tests/stages.test.ts --config vitest.config.ts",
    "test:prompts": "vitest run tests/prompts.test.ts --config vitest.config.ts",
    "test:wiki": "vitest run tests/wiki.test.ts --config vitest.config.ts",
    "test:validation": "vitest run tests/validation.test.ts --config vitest.config.ts",
    "test:output": "vitest run tests/output.test.ts --config vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "drizzle-orm": "^0.38.0",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.0",
    "commander": "^13.0.0",
    "chalk": "^5.4.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  }
}
