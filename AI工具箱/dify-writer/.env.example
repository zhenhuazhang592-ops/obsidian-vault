# Dify API
DIFY_API_KEY=your-dify-api-key-here
DIFY_BASE_URL=https://api.dify.ai/v1

# Dify Chatflow ID (for HITL webhook)
DIFY_CHATFLOW_ID=your-chatflow-id-here

# HITL Webhook Bearer Token (generate a secure random string)
DIFY_WEBHOOK_BEARER_TOKEN=your-webhook-token-here

# Dify Webhook URL (your server's public URL for Dify to call back)
DIFY_WEBHOOK_URL=https://your-server.com/webhooks/dify/hitl

# MCP Server
MCP_SERVER_KEY=your-mcp-server-key-here

# Tavily (for deep research)
TAVILY_API_KEY=your-tavily-api-key-here

# 图像生成（即梦/可灵）
JIMENG_API_KEY=your-jimeng-api-key-here

# 日志级别
LOG_LEVEL=INFO
