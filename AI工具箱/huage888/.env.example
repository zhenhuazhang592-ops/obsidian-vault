# huage888 环境变量配置
# 复制本文件为 .env 并填入真实 Key
# 注意：.env 文件不要提交到仓库！

# ── Qwen-Max（通义千问）──────────────────────────────────────────────
# 用途：大纲 / 分镜 / 角色提示词 等文字内容生成
# 获取：https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-42f70ee654324ca592b1e04c02fafea4

# ── Doubao / 即梦（火山引擎）────────────────────────────────────────
# 用途：Seedream 图生图 + Seedance 2.0 图生视频
# 获取：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# 必填：需开通 Seedance 2.0（视频）和 Seedream 5.0（图片）模型
ARK_API_KEY=YOUR_ARK_API_KEY_HERE

# 可选（已有默认值，可不填）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── Kling（可选，备用视频模型）─────────────────────────────────────
# KLING_API_KEY=YOUR_KLING_API_KEY_HERE
# KLING_KEY_ID=YOUR_KLING_KEY_ID_HERE
# KLING_BASE_URL=https://api.klingai.com
